# Пример конфига nginx для проксирования на Node-бэкенд Saran.
# Скопируйте на VPS в /etc/nginx/sites-available/, поправьте домен и порт,
# затем: ln -s .../sites-available/saran-backend.conf /etc/nginx/sites-enabled/
# и получите сертификат: certbot --nginx -d api.saran-edu.ru

server {
    listen 80;
    server_name api.saran-edu.ru;

    location / {
        proxy_pass http://127.0.0.1:8010;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}

# После certbot --nginx появится блок listen 443 ssl с сертификатами —
# certbot добавит его автоматически при первом запуске.
