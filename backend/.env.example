# ==========================================================================
# Saran Backend — переменные окружения
# Скопируйте этот файл в .env и заполните реальными значениями на VPS.
# Никогда не коммитьте .env в git.
# ==========================================================================

# --- Общее ---
NODE_ENV=production
PORT=8010
# Публичный URL, на котором будет доступен бэкенд (для писем/логов)
PUBLIC_URL=https://api.saran-edu.ru
# URL фронтенда — используется для ссылки восстановления пароля в письме.
# ВАЖНО: на фронтенде должна существовать страница/маршрут /reset-password,
# принимающая ?token=... и вызывающая POST /api/auth/reset-password.
FRONTEND_URL=https://saran-edu.ru

# --- CORS ---
# Список разрешённых источников (фронтенд), через запятую, без пробелов.
CORS_ORIGIN=https://saran-edu.ru,https://saran-edu.ru/app,http://localhost:3000

# --- JWT ---
# Сгенерировать секрет: node scripts/generate-secret.js
JWT_ACCESS_SECRET=REPLACE_ME_WITH_RANDOM_64_HEX
JWT_REFRESH_SECRET=REPLACE_ME_WITH_ANOTHER_RANDOM_64_HEX
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Cookies (refresh-токен хранится в httpOnly cookie) ---
COOKIE_DOMAIN=saran-edu.ru
COOKIE_SECURE=true

# --- База данных (SQLite-файл) ---
DATABASE_PATH=./data/saran.sqlite3

# --- Ограничение частоты запросов на auth-эндпоинты ---
AUTH_RATE_LIMIT_WINDOW_MINUTES=15
AUTH_RATE_LIMIT_MAX=20

# --- Почта (для восстановления пароля / подтверждения email) ---
# Если не заполнено — письма не отправляются, а ссылка пишется в лог сервера (режим разработки).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Saran <no-reply@saran-edu.ru>"

# --- Админ ---
# Произвольный секретный токен для доступа к /api/admin/*
ADMIN_TOKEN=REPLACE_ME_WITH_RANDOM_ADMIN_TOKEN
